{"auth":{"bearer":[{"key":"token","value":"{{token}}"}],"type":"bearer"},"info":{"description":"CityPulse AI — /api/v1 contract (Blueprint section 6). CityFix Buildathon (Tutedude). Base URL: {{base_url}}. Authenticate with POST /auth/login and use {{token}} for protected requests. Demo accounts: admin@citypulse.demo / demo1234, priya@citypulse.demo / demo1234.","name":"CityPulse AI API","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"item":[{"item":[{"name":"Register citizen (TC01)","request":{"body":{"mode":"raw","raw":"{\n  \"name\": \"Test Citizen\",\n  \"email\": \"test-{{$timestamp}}@citypulse.test\",\n  \"password\": \"Password123\"\n}"},"header":[{"key":"Content-Type","value":"application/json"}],"method":"POST","url":"{{base_url}}/auth/register"}},{"event":[{"listen":"test","script":{"exec":["if (pm.response.code === 200) {","  pm.collectionVariables.set('token', pm.response.json().access_token);","}"],"type":"text/javascript"}}],"name":"Login (TC02)","request":{"body":{"mode":"raw","raw":"{\n  \"email\": \"priya@citypulse.demo\",\n  \"password\": \"demo1234\"\n}"},"header":[{"key":"Content-Type","value":"application/json"}],"method":"POST","url":"{{base_url}}/auth/login"}},{"name":"Login with invalid credentials (TC02 negative)","request":{"body":{"mode":"raw","raw":"{\n  \"email\": \"nobody@citypulse.demo\",\n  \"password\": \"wrong-password\"\n}"},"header":[{"key":"Content-Type","value":"application/json"}],"method":"POST","url":"{{base_url}}/auth/login"}}],"name":"Auth"},{"item":[{"event":[{"listen":"test","script":{"exec":["if (pm.response.code === 201) {","  pm.collectionVariables.set('complaint_id', pm.response.json().id);","}"],"type":"text/javascript"}}],"name":"Create complaint (TC03, TC05, TC10)","request":{"body":{"mode":"raw","raw":"{\n  \"category\": \"Pothole\",\n  \"description\": \"Deep pothole near the junction. (Demo data)\",\n  \"ward\": \"Jubilee Hills\",\n  \"location\": { \"latitude\": 17.4326, \"longitude\": 78.4071, \"address\": \"Road No. 36, Jubilee Hills\" }\n}"},"header":[{"key":"Content-Type","value":"application/json"}],"method":"POST","url":"{{base_url}}/complaints"}},{"name":"List complaints","request":{"method":"GET","url":"{{base_url}}/complaints"}},{"name":"Complaint details (TC11)","request":{"method":"GET","url":"{{base_url}}/complaints/{{complaint_id}}"}},{"name":"Complaint status history (TC14)","request":{"method":"GET","url":"{{base_url}}/complaints/{{complaint_id}}/history"}},{"name":"Upload image (TC04)","request":{"body":{"formdata":[{"key":"file","src":[],"type":"file"}],"mode":"formdata"},"method":"POST","url":"{{base_url}}/complaints/{{complaint_id}}/media"}},{"name":"Possible duplicates (TC08, TC09)","request":{"method":"GET","url":"{{base_url}}/complaints/{{complaint_id}}/duplicates"}},{"name":"Add comment","request":{"body":{"mode":"raw","raw":"{\n  \"comment\": \"This pothole has been there for two weeks. (Demo data)\"\n}"},"header":[{"key":"Content-Type","value":"application/json"}],"method":"POST","url":"{{base_url}}/complaints/{{complaint_id}}/comments"}}],"name":"Complaints"},{"item":[{"name":"Analyse image (TC06, TC07)","request":{"body":{"formdata":[{"key":"file","src":[],"type":"file"}],"mode":"formdata"},"method":"POST","url":"{{base_url}}/ai/analyze"}},{"name":"Analyse image — provider timeout (TC18)","request":{"body":{"formdata":[{"key":"simulate_timeout","type":"text","value":"true"}],"mode":"formdata"},"method":"POST","url":"{{base_url}}/ai/analyze"}}],"name":"AI"},{"item":[{"name":"Update status (TC12, TC13, TC17)","request":{"body":{"mode":"raw","raw":"{\n  \"new_status\": \"UNDER REVIEW\",\n  \"remarks\": \"Photo and location checked.\"\n}"},"header":[{"key":"Content-Type","value":"application/json"}],"method":"PATCH","url":"{{base_url}}/admin/complaints/{{complaint_id}}/status"}},{"name":"Reject with reason (reason required)","request":{"body":{"mode":"raw","raw":"{\n  \"new_status\": \"REJECTED\",\n  \"remarks\": \"