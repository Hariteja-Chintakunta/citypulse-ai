# CityPulse AI — example environment variables.
# Copy to .env (backend) / .env.local (frontend) and fill in real values.
# NEVER commit a filled-in .env file.

# --- Backend ---
DATABASE_URL=postgresql://user:password@localhost:5432/citypulse
# For local development without PostgreSQL, the backend defaults to SQLite:
# DATABASE_URL=sqlite:///./citypulse.db
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000

# --- AI (optional) ---
# Leave unset to run POST /api/v1/ai/analyze in clearly-labelled mock/suggestion mode.
VISION_API_KEY=
VISION_API_MODEL=vision-model
AI_CONFIDENCE_THRESHOLD=0.70
DUPLICATE_RADIUS_M=50
DUPLICATE_WINDOW_DAYS=14

# --- Supabase (deployment) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DEMO_MODE=true
